---
import Dashboard from '../components/Dashboard';
import Layout from '../layouts/Layout.astro';

---

<Layout>
	<Dashboard client:only="react">
		<div slot="fallback" class="app-shell">
			<header class="site-header flex items-center"><a class="brand" href="/">brent outlook.</a></header>
			<main class="market-section"><h1>The price of now.</h1><p class="section-description" role="status">Loading live Brent prices and the benchmark outlook…</p><noscript>Enable JavaScript to view live prices, charts, and projections.</noscript></main>
		</div>
	</Dashboard>
</Layout>
