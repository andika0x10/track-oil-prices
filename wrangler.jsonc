{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "track-oil-prices",
  "main": "./src/worker.ts",
  "kv_namespaces": [{ "binding": "OUTLOOK" }],
  "triggers": { "crons": ["0 0 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
